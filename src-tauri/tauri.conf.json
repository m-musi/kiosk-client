{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elecbalance Kiosk",
  "version": "0.1.0",
  "identifier": "com.elecbalance.kiosk",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "山西省电力仿真考试客户端",
        "url": "guide.html",
        "width": 860,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "fullscreen": false,
        "resizable": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://file.mengjia.site/kiosk/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEMTIyNEY1MjA0RDZCODMKUldTRGEwMGc5U1FTTGU1blFxcVB0eCtKTTNuc1o3Zll5OTJpWkIvU1Q3R1JLRFlLMlQ5SURER2cK"
    }
  }
}
