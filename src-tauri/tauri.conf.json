{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elecbalance Kiosk",
  "version": "0.1.0",
  "identifier": "com.elecbalance.kiosk",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "山西省电力仿真考试客户端",
        "url": "guide.html",
        "width": 960,
        "height": 660,
        "decorations": true,
        "fullscreen": false,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://updates.elecbalance.com/kiosk/latest.json"],
      "pubkey": ""
    }
  }
}
