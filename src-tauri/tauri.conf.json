{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elecbalance Kiosk",
  "version": "0.1.0",
  "identifier": "com.elecbalance.kiosk",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Elecbalance Kiosk",
        "url": "https://sim.elecbalance.com/login",
        "width": 1366,
        "height": 800,
        "decorations": false,
        "fullscreen": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://updates.elecbalance.com/kiosk/latest.json"],
      "pubkey": ""
    }
  }
}
